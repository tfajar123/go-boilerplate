# Staging Environment Configuration
APP_ENV=staging
APP_PORT=3098
JWT_ACCESS_SECRET=SUPER_SECRET_KEY_STAGING
JWT_REFRESH_SECRET=REFRESH_SECRET_STAGING

# External Database (provided by staging server)
DATABASE_URL=postgres://username:password@staging-postgres:5432/boilerplate_staging?sslmode=disable

# External Redis (provided by staging server)
REDIS_HOST=staging-redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=default
REDIS_PASSWORD=staging_redis_password
REDIS_TLS=false

# External MinIO (provided by staging server)
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=uploads
STORAGE_USE_SSL=false
STORAGE_PUBLIC_URL=http://localhost:9000

# External PostgreSQL connection details for health checks
POSTGRES_HOST=staging-postgres
POSTGRES_PORT=5432
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=boilerplate_staging


MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@email.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_EMAIL=your@email.com
MAIL_FROM_NAME=Go Boilerplate
MAIL_RESET_PASSWORD_URL=http://localhost:3000/reset-password